# ── Copie ce fichier en .env et remplis les valeurs ──────────────────────────

# Port du serveur
PORT=3001

# Clé admin pour les routes d'écriture de l'API.
# Minimum 32 caractères, sinon l'écriture est désactivée.
# Génère-la avec :  openssl rand -hex 32
ADMIN_KEY=

# IPs autorisées pour les routes admin (correspondance exacte, séparées par des virgules)
ADMIN_IPS=127.0.0.1,::1

# Origines autorisées pour CORS (uniquement utile en dev, le site est servi par le même serveur en prod)
ALLOWED_ORIGINS=http://localhost:3000

# true UNIQUEMENT si le serveur est derrière un reverse proxy (nginx, Caddy, Traefik…)
# qui ajoute l'en-tête X-Forwarded-For. Sinon n'importe qui peut usurper son IP.
TRUST_PROXY=false

# true si le site est servi en HTTPS (active HSTS + upgrade-insecure-requests)
HSTS=false

# Compte GitHub affiché dans le graphe d'activité (page d'accueil)
GITHUB_USER=Atlasentinel
