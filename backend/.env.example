# ── Copie ce fichier en .env et remplis les valeurs ──────────────────────────

# Port du serveur
PORT=3001

# Clé admin — CHANGE cette valeur, ne laisse JAMAIS la valeur par défaut en prod
# Génère une clé forte : openssl rand -hex 32
ADMIN_KEY=CHANGE_MOI_AVANT_DE_DEPLOYER

# Origines autorisées pour CORS (séparées par des virgules, sans espace)
# Dev  : http://localhost:3000
# Prod : https://ton-domaine.com
ALLOWED_ORIGINS=http://localhost:3000

# IPs autorisées pour les routes admin (séparées par des virgules)
# Par défaut : localhost uniquement
# Pour accès distant : ajoute ton IP fixe (ex: 82.64.12.34)
ADMIN_IPS=127.0.0.1,::1
